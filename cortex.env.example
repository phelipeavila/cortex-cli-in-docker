# Cortex CLI Environment Configuration
# Copy this file to cortex.env and fill in your credentials
# IMPORTANT: Never commit cortex.env to version control!

# Your Cortex API Key ID (from Settings > Data Sources > Cortex CLI)
CORTEX_API_KEY_ID=your-api-key-id-here

# Your Cortex API Key Secret
CORTEX_API_KEY=your-api-key-secret-here

# Your Cortex Tenant API URL
# Examples:
#   US: https://api-your-tenant.xdr.us.paloaltonetworks.com
#   EU: https://api-your-tenant.xdr.eu.paloaltonetworks.com
CORTEX_API_BASE_URL=https://api-your-tenant.xdr.us.paloaltonetworks.com

# Optional: Proxy configuration (uncomment if needed)
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# Optional: Disable TLS certificate verification (not recommended for production)
# CORTEX_NO_CERT_VERIFY=true

# Optional: Enable soft fail mode (exit 0 even on findings)
# CORTEX_SOFT_FAIL=true

